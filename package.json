{
  "name": "deva-workspace",
  "private": true,
  "description": "Deva - 对话式 AI 助手 · All in Chat",
  "license": "MIT",
  "packageManager": "pnpm@10.8.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @deva/desktop dev",
    "build": "pnpm --filter @deva/desktop build",
    "build:web": "pnpm --filter @deva/desktop build && pnpm --filter @deva/web build",
    "start": "pnpm --filter @deva/desktop start",
    "start:web": "pnpm --filter @deva/web start",
    "typecheck": "pnpm --filter @deva/desktop typecheck && pnpm --filter @deva/web typecheck",
    "lint": "eslint .",
    "package:win": "pnpm --filter @deva/desktop build:win",
    "package:mac": "pnpm --filter @deva/desktop build:mac",
    "package:linux": "pnpm --filter @deva/desktop build:linux",
    "relay:login": "pnpm --filter @deva/relay exec wrangler login --device",
    "relay:deploy": "pnpm --filter @deva/desktop build:mobile && pnpm --filter @deva/relay run deploy",
    "relay:dev": "pnpm --filter @deva/desktop build:mobile && pnpm --filter @deva/relay run dev",
    "relay-node:build": "pnpm --filter @deva/desktop build:mobile && pnpm --filter @deva/relay-node run build",
    "relay-node:deploy": "pnpm relay-node:build && pnpm --filter @deva/relay-node run deploy",
    "relay-node:start": "pnpm --filter @deva/relay-node run start"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild",
      "@parcel/watcher"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "9",
    "eslint-plugin-react-hooks": "^5",
    "globals": "^17.14.0",
    "typescript-eslint": "^8"
  }
}
