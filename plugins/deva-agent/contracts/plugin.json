  "rpc": {
    "get-identities": {
      "description": "读取身份目录与当前用户/Profile 的默认选择。",
      "input": "empty",
      "output": "identityList"
    },
    "save-selection": {
      "description": "保存当前用户/Profile 的默认身份，下一轮运行生效。",
      "input": "selection",
      "output": "saved"
    },
    "get-mcp-servers": {
      "description": "读取当前用户/Profile 可勾选的 MCP 服务：名称、传输、启用状态、工具数，以及已勾选的服务名。服务清单来自 Studio 自己的 MCP 管理（GET /api/ekko/mcp/servers）；宿主通道不可用或请求失败时抛错，不返回空表。",
      "input": "empty",
      "output": "studioMcpList"
    },
    "save-mcp-selection": {
      "description": "保存当前用户/Profile 勾选的 Studio MCP 服务名；下一轮运行按这份清单取连接配置。只存名字，不存配置与密钥。",
      "input": "mcpSelection",
      "output": "mcpSaved"
    },
    "get-mcp-server": {
      "description": "读取单个 Studio MCP 服务的连接配置，用于编辑回填。列表接口不下发配置与密钥，只有这里按服务名单独取。",
      "input": "mcpServerTarget",
      "output": "mcpServerDetail"
    },
    "create-mcp-server": {
      "description": "在 Studio 的 MCP 服务表里新增一个服务（POST /api/ekko/mcp/servers）。配置由 Studio 校验与规范化；重名、类型非法等错误原样抛给页面。",
      "input": "mcpServerDraft",
      "output": "mcpServerSaved"
    },
    "update-mcp-server": {
      "description": "用新配置整体覆盖 Studio 里已有 MCP 服务（PATCH /api/ekko/mcp/servers/:name）。服务不存在时报错，不新建。",
      "input": "mcpServerUpdate",
      "output": "mcpServerSaved"
    },
    "set-mcp-server-enabled": {
      "description": "在 Studio 里启用或停用 MCP 服务（PATCH /api/ekko/mcp/servers/:name {enabled}）。停用的服务本轮不连接。",
      "input": "mcpServerEnabled",
      "output": "mcpServerSaved"
    },
    "delete-mcp-server": {
      "description": "从 Studio 删除 MCP 服务（DELETE /api/ekko/mcp/servers/:name）。插件只删 Studio 里的服务表项，不动自己的勾选记录；下一轮勾选里缺失的服务会在提示词里点名。",
      "input": "mcpServerTarget",
      "output": "mcpServerRemoved"
    },
    "test-mcp-server": {
      "description": "让 Studio 连一次该 MCP 服务并列出工具（POST /api/ekko/mcp/servers/:name/test）。服务停用或连不上时抛错，不返回空表。",
      "input": "mcpServerTarget",
      "output": "mcpTools"
    }
  },
