{
  "schemaVersion": 1,
  "description": "Deva 项目 Agent 插件：注册一个 Agent、身份目录的读取/默认值保存（user+profile）、会话内切换身份的斜杠命令，以及 Studio MCP 服务的增删改查/启停/测试与每个 Agent 的勾选保存。身份与勾选写在宿主提供的存储里，MCP 连接配置只有 Studio 一份。",
  "models": {
    "empty": {
      "type": "null",
      "description": "无参数请求；前端省略 RPC input 时宿主传入 null。"
    },
    "commandArgs": {
      "type": "string",
      "description": "斜杠命令后的原始参数字符串；不带参数时为空字符串。"
    },
    "identityList": {
      "type": "object",
      "description": "全部可选身份与当前选择。",
      "properties": {
        "identities": {
          "type": "array",
          "description": "身份目录，顺序即设置页下拉与命令提示的顺序。",
          "items": {
            "type": "object",
            "description": "一个可选身份。",
            "properties": {
              "id": {
                "type": "string",
                "description": "身份 id，稳定不变，用于保存与回读。",
                "maxLength": 64
              },
              "name": {
                "type": "string",
                "description": "显示名。",
                "maxLength": 120
              },
              "description": {
                "type": "string",
                "description": "一句话说明这个身份适合什么任务。",
                "maxLength": 400
              }
            },
            "required": [
              "id",
              "name",
              "description"
            ],
            "additionalProperties": false
          }
        },
        "selected": {
          "type": "string",
          "description": "当前用户与 Profile 已选中的默认身份 id；没选过时为 deva。",
          "maxLength": 64
        }
      },
      "required": [
        "identities",
        "selected"
      ],
      "additionalProperties": false
    },
    "identityState": {
      "type": "object",
      "description": "命令执行后的身份状态：本轮生效的身份、来源与可选目录。",
      "properties": {
        "current": {
          "type": "string",
          "description": "当前生效的身份 id（会话覆盖优先于默认）。",
          "maxLength": 64
        },
        "source": {
          "type": "string",
          "description": "生效来源：session 表示本会话覆盖，profile 表示用户/Profile 默认。",
          "enum": [
            "session",
            "profile"
          ]
        },
        "identities": {
          "type": "array",
          "description": "可选身份目录。",
          "items": {
            "type": "object",
            "description": "一个可选身份。",
            "properties": {
              "id": {
                "type": "string",
                "description": "身份 id。",
                "maxLength": 64
              },
              "name": {
                "type": "string",
                "description": "显示名。",
                "maxLength": 120
              },
              "description": {
                "type": "string",
                "description": "一句话说明。",
                "maxLength": 400
              }
            },
            "required": [
              "id",
              "name",
              "description"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "current",
        "source",
        "identities"
      ],
      "additionalProperties": false
    },
    "selection": {
      "type": "object",
      "description": "要保存的默认身份选择。",
      "properties": {
        "identity": {
          "type": "string",
          "description": "身份 id，必须是身份目录内的 id；未知 id 会被拒绝。",
          "maxLength": 64
        }
      },
      "required": [
        "identity"
      ],
      "additionalProperties": false
    },
    "saved": {
      "type": "object",
      "description": "保存成功的结果。",
      "properties": {
        "ok": {
          "type": "boolean",
          "description": "仅在写入完成后返回 true；失败抛错。",
          "enum": [
            true
          ]
        },
        "selected": {
          "type": "string",
          "description": "保存后的身份 id。",
          "maxLength": 64
        }
      },
      "required": [
        "ok",
        "selected"
      ],
      "additionalProperties": false
    },
    "studioMcpList": {
      "type": "object",
      "description": "Studio 的 MCP 服务清单与当前用户/Profile 的勾选结果。",
      "properties": {
        "servers": {
          "type": "array",
          "description": "Studio 里全部 MCP 服务，按 Studio 返回顺序。",
          "items": {
            "type": "object",
            "description": "Studio 里已配置的一个 MCP 服务（只含展示字段，不含连接配置与密钥）。",
            "properties": {
              "name": {
                "type": "string",
                "description": "服务名，Studio 与本插件都用它做工具命名空间。",
                "maxLength": 64
              },
              "transport": {
                "type": "string",
                "description": "传输类型：stdio 或 http（Studio 的 streamable_http 统一显示为 http）；无法判断时为空字符串。",
                "maxLength": 32
              },
              "managed": {
                "type": "boolean",
                "description": "是否由 Studio 自己托管（这类服务的凭证由宿主提供）。"
              },
              "enabled": {
                "type": "boolean",
                "description": "是否在 Studio 里启用；停用的服务本轮不会连接。"
              }
            },
            "required": [
              "name",
              "transport",
              "managed",
              "enabled"
            ],
            "additionalProperties": false
          },
          "maxItems": 200
        },
        "selected": {
          "type": "array",
          "description": "当前用户/Profile 勾选的服务名；可能包含 Studio 里已删除的服务（运行时会在提示词里点名）。",
          "items": {
            "type": "string",
            "description": "服务名。",
            "maxLength": 64
          },
          "maxItems": 32
        }
      },
      "required": [
        "servers",
        "selected"
      ],
      "additionalProperties": false
    },
    "mcpSelection": {
      "type": "object",
      "description": "要保存的 Studio MCP 服务勾选（只存服务名，不存连接配置或密钥）。",
      "properties": {
        "servers": {
          "type": "array",
          "description": "勾选的服务名，最多 32 个；重名去重，非法名字整批拒绝。",
          "items": {
            "type": "string",
            "description": "服务名：字母或数字开头，最多 64 位，可含点、下划线、连字符（与 Studio 规则一致）。",
            "maxLength": 64
          },
          "maxItems": 32
        }
      },
      "required": [
        "servers"
      ],
      "additionalProperties": false
    },
    "mcpSaved": {
      "type": "object",
      "description": "保存成功后的 Studio MCP 勾选。",
      "properties": {
        "ok": {
          "type": "boolean",
          "description": "仅在写入完成后返回 true；失败抛错。",
          "enum": [
            true
          ]
        },
        "selected": {
          "type": "array",
          "description": "实际写入的服务名（去重后）。",
          "items": {
            "type": "string",
            "description": "服务名。",
            "maxLength": 64
          },
          "maxItems": 32
        }
      },
      "required": [
        "ok",
        "selected"
      ],
      "additionalProperties": false
    },
    "mcpConfig": {
      "type": "object",
      "description": "Studio MCP 服务的连接配置（由 Studio 规范化：stdio 需要 command，streamable_http 需要 http(s) url，enabled 为布尔）。",
      "properties": {
        "type": {
          "type": "string",
          "description": "传输类型；只接受 stdio 或 streamable_http（http 视作 streamable_http）。",
          "enum": [
            "stdio",
            "streamable_http"
          ],
          "maxLength": 32
        },
        "command": {
          "type": "string",
          "description": "stdio 的启动命令（可执行文件名或绝对路径）。",
          "maxLength": 4096
        },
        "args": {
          "type": "array",
          "description": "stdio 命令参数，按顺序传入。",
          "items": {
            "type": "string",
            "description": "一个命令行参数。",
            "maxLength": 4096
          },
          "maxItems": 128
        },
        "env": {
          "type": "object",
          "description": "stdio 子进程的环境变量；键值都是字符串，值可用 ${VAR} 引用 Studio 进程环境。",
          "properties": {},
          "required": [],
          "additionalProperties": true
        },
        "url": {
          "type": "string",
          "description": "streamable_http 的服务地址，必须是 http 或 https。",
          "maxLength": 4096
        },
        "headers": {
          "type": "object",
          "description": "streamable_http 的请求头；键值都是字符串，值可用 ${VAR} 引用 Studio 进程环境。",
          "properties": {},
          "required": [],
          "additionalProperties": true
        },
        "enabled": {
          "type": "boolean",
          "description": "是否启用；停用的服务不会连接，也不能测试。"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "mcpServer": {
      "type": "object",
      "description": "Studio 里一个 MCP 服务的展示字段（不含连接配置与密钥）。",
      "properties": {
        "name": {
          "type": "string",
          "description": "服务名，Studio 与插件都用它做工具命名空间。",
