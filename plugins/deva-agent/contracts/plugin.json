          "maxLength": 32
        },
        "managed": {
          "type": "boolean",
          "description": "是否由 Studio 自己托管（这类服务的凭证由宿主提供）。"
        },
        "enabled": {
          "type": "boolean",
          "description": "是否在 Studio 里启用；停用的服务本轮不会连接。"
        }
      },
      "required": [
        "name",
        "transport",
        "managed",
        "enabled"
      ],
      "additionalProperties": false
    },
    "mcpServerDetail": {
      "type": "object",
      "description": "一个 MCP 服务的展示字段与完整连接配置（编辑表单需要回填）。",
      "properties": {
        "server": {
          "type": "object",
          "description": "服务名、传输与启停状态。",
          "properties": {
            "name": {
              "type": "string",
              "description": "服务名，Studio 与插件都用它做工具命名空间。",
