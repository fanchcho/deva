                "maxLength": 4096
              },
              "maxItems": 128
            },
            "env": {
              "type": "object",
              "description": "stdio 子进程的环境变量；键值都是字符串，值可用 ${VAR} 引用 Studio 进程环境。",
              "properties": {},
              "required": [],
              "additionalProperties": true
            },
            "url": {
              "type": "string",
              "description": "streamable_http 的服务地址，必须是 http 或 https。",
              "maxLength": 4096
            },
            "headers": {
              "type": "object",
              "description": "streamable_http 的请求头；键值都是字符串，值可用 ${VAR} 引用 Studio 进程环境。",
              "properties": {},
