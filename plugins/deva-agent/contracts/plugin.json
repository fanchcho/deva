      "properties": {
        "name": {
          "type": "string",
          "description": "服务名，必须已存在于 Studio。",
          "maxLength": 64
        },
        "config": {
          "type": "object",
          "description": "Studio MCP 服务的连接配置（由 Studio 规范化：stdio 需要 command，streamable_http 需要 http(s) url，enabled 为布尔）。",
