        "config"
      ],
      "additionalProperties": false
    },
    "mcpServerTarget": {
      "type": "object",
      "description": "按名字定位一个已有的 Studio MCP 服务。",
      "properties": {
        "name": {
          "type": "string",
          "description": "服务名，必须与 Studio 里的名字完全一致（字母或数字开头，最多 64 位，可含点、下划线、连字符）。",
          "maxLength": 64
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
