# Compose 运行参数；复制为 apps/web/.env
DEVA_WEB_MEM_LIMIT=1280m
DEVA_WEB_MEMSWAP_LIMIT=1280m
DEVA_WEB_NODE_HEAP_MB=256
DEVA_WEB_SHM_SIZE=256m
WATCHTOWER_POLL_INTERVAL=900
# 本地覆盖层构建参数
PNPM_CHILD_CONCURRENCY=1
PNPM_NETWORK_CONCURRENCY=4
BUILD_NODE_HEAP_MB=768
# 构建前通过 git rev-parse HEAD 设置，避免版本检查丢失当前 commit
DEVA_COMMIT=
DEVA_REF=deva_web
